# Neon Postgres connection string (Payload stores pages, libraries, media records and enquiries here)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/peregrine?sslmode=verify-full

# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# Public address of the site, no trailing slash (used for live preview, sitemap, CORS)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used by the admin "Preview" button to open draft pages
PREVIEW_SECRET=

# Email (optional until a provider is chosen). Without RESEND_API_KEY, enquiries are still
# saved in the admin under Enquiries and the notification email is only logged.
RESEND_API_KEY=
EMAIL_FROM=website@peregrine.al
ENQUIRY_TO=info@peregrine.al

# Image storage on Cloudflare R2 (required before go-live). Without R2_BUCKET, uploads stay in /media on local disk.
# Create the bucket and an R2 API token with Object Read & Write on that bucket only.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# First Owner account created by `npm run seed` (change the password after the first login)
SEED_OWNER_EMAIL=info@peregrine.al
SEED_OWNER_PASSWORD=
